{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/components/*": ["./src/components/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/*": ["./src/*"],
      "@ringwise/agent-core/*": ["../../packages/agent-core/src/*"],
      "@ringwise/contracts": ["../../packages/contracts/src"],
      "@ringwise/db": ["../../packages/db/src"],
      "@ringwise/domain": ["../../packages/domain/src"],
      "@ringwise/jobs": ["../../packages/jobs/src"],
      "@ringwise/providers": ["../../packages/providers/src"],
      "@ringwise/providers/*": ["../../packages/providers/src/*"],
      "@ringwise/shared": ["../../packages/shared/src"],
      "@ringwise/telemetry": ["../../packages/telemetry/src"],
      "@ringwise/telemetry/*": ["../../packages/telemetry/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
