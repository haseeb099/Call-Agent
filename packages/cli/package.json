{
  "name": "@ringwise/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The ringwise command: onboard and manage businesses through the Ringwise API.",
  "bin": {
    "ringwise": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ringwise/shared": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "8.5.1",
    "vitest": "^5.1.1"
  }
}
